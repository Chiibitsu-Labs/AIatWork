# Resend ~ used by api/subscribe.js (server-side only, never exposed to the client)
RESEND_API_KEY=
RESEND_MERG_SEGMENT_ID=
RESEND_FROM_EMAIL=
NEXT_PUBLIC_SITE_URL=

# Optional: also adds consenting contacts to this segment
RESEND_CHIIBITSU_AI_UPDATES_SEGMENT_ID=

# Second Brain Kit gate ~ used by middleware.js + api/2nd-brain-kit-unlock.js
# to protect /2nd-brain-kit. SETUP_ACCESS_KEYS is a comma-separated list of
# valid keys (issue one per client, revoke by removing it). SETUP_COOKIE_SECRET
# signs the session cookie and must be 32+ chars (e.g. `openssl rand -hex 32`)
# or the gate fails closed.
SETUP_ACCESS_KEYS=
SETUP_COOKIE_SECRET=
